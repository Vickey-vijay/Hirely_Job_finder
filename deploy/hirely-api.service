[Unit]
Description=Hirely API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=hirely
WorkingDirectory=/srv/hirely/api
EnvironmentFile=/srv/hirely/api/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
