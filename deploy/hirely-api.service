[Unit]
Description=Hirely API and job worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=hirely
WorkingDirectory=/srv/hirely/api
EnvironmentFile=/srv/hirely/api/.env
ExecStart=/usr/bin/node --max-old-space-size=220 dist/index.js
Restart=always
RestartSec=5
# Keep this small app from starving the other apps on a 1 GB server
MemoryMax=320M
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
