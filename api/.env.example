# Copy to .env and fill in. Never commit .env.

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Same value goes in web/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated browser origins allowed to call the API (must match where the web app is opened).
ALLOWED_ORIGINS=http://localhost:5173

PORT=4000
NODE_ENV=development
