# Copy to .env and fill in. Never commit .env.

# --- Required ---
# PostgreSQL. Local (docker compose up -d db) matches the line below.
DATABASE_URL=postgres://hirely:hirely@localhost:5432/hirely

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated browser origins allowed to call the API (must match where the web app is opened).
ALLOWED_ORIGINS=http://localhost:5173

PORT=4000
NODE_ENV=development

# --- Google login (optional: leave empty to disable) ---
# From Google Cloud Console > Credentials > OAuth client ID (Web application).
# Same value goes in web/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- Email login ---
# Development: leave SMTP_* empty and the 6-digit code is printed in the API console.
# Production: required. Works with any SMTP provider (Brevo, Amazon SES, Resend, Zoho, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hirely <login@yourdomain.com>"
