# Copy to .env and fill in. Never commit .env.
# Only JWT_SECRET is required on your computer. Every empty value leaves that feature off.
# The server's copy is created by deploy/setup-server.sh at /srv/hirely/api/.env.

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PostgreSQL. Required in production. Empty on your computer = embedded database in api/data/.
DATABASE_URL=

# Where the website is opened from (comma separated), and the address used in links we send.
ALLOWED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# Your email(s), comma separated: these accounts can open /admin.
ADMIN_EMAILS=

# ---- Sign-in ----
# Google: OAuth client ID (Web application) from Google Cloud Console. The website reads it from the API.
GOOGLE_CLIENT_ID=
# Email codes and email alerts: any SMTP provider. Empty on your computer = codes print in this console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hirely <alerts@yourdomain.in>"

# ---- Payments ----
# No Razorpay keys + ALLOW_MOCK_PAYMENTS=true  -> test mode, no money moves.
# Keys only                                    -> one-time 30-day pass.
# Keys + all three plan IDs                    -> monthly auto-debit subscriptions.
# BILLING_MODE=pass | off can force a mode.
ALLOW_MOCK_PAYMENTS=true
BILLING_MODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PLUS=
RAZORPAY_PLAN_PRO=

# ---- Telegram bot (free). Empty token = Telegram is off everywhere. See docs/START_HERE.md section 8g ----
# Token from @BotFather (/newbot). Username is the bot's name without the @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random, 16+ letters, digits, _ or -. Telegram sends it back with every update; it must match.
TELEGRAM_WEBHOOK_SECRET=

# ---- WhatsApp Cloud API (official) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=job_digest
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v27.0

# ---- AI (Claude): resume reading, score refinement, Pro tailored resumes ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# ---- Adzuna India job search (free keys from developer.adzuna.com) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Set to false to stop collecting jobs (useful when working on the website only).
INGEST_ENABLED=true

# ---- Shown on the policy and contact pages ----
BUSINESS_NAME=Hirely
CONTACT_EMAIL=
BUSINESS_ADDRESS=
GRIEVANCE_NAME=
SUPPORT_UPI=
